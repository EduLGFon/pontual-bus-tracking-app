# Copy to a root-owned 0600 file on the host only. Never commit the real file.
APP_ENV=local
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/dbname
ALLOWED_ORIGINS=http://127.0.0.1:8080
TRUST_CLOUDFLARE=false
DATA_DIR=./build
LOG_LEVEL=info
METRICS_PORT=127.0.0.1:9091
# Local-dev line seed until the T14 bundle lands. Empty in staging/prod.
LINES_JSON=[]
