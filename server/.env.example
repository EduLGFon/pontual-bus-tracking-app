# Local-dev values. Copy to server/.env (gitignored, never commit it) and
# adjust. See README.md "Local end-to-end run".
APP_ENV=local
HOST=127.0.0.1
PORT=8080
# Local PostgreSQL on 5433 (docker container pontual-pg). CI uses 5432.
DATABASE_URL=postgresql://postgres:test@127.0.0.1:5433/pontual_test?sslmode=disable
# Exact origins allowed on the stream and CORS. The API itself plus the
# pinned flutter web dev port (flutter run --web-port 5000).
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:5000
TRUST_CLOUDFLARE=false
# Built static bundle from the repo root (deno task data-build in tools/).
DATA_DIR=../build
LOG_LEVEL=info
METRICS_PORT=127.0.0.1:9091
# Local-dev line seed until the T14 bundle lands. Empty in staging/prod.
LINES_JSON=[]
