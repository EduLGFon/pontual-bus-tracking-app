# systemd unit for the Pontual API (T05). Installed by the owner on the
# VPS per docs/runbooks/vps-hardening.md. Hardening flags follow
# PLAN.md 12.8. The process binds localhost only; Caddy proxies it.
[Unit]
Description=Pontual bus-tracking API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pontual
Group=pontual
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
LimitCORE=0
LimitNOFILE=4096
ReadWritePaths=/opt/pontual/current
WorkingDirectory=/opt/pontual/current/server
EnvironmentFile=/etc/pontual/env
ExecStart=/usr/local/bin/deno task start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
